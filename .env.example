# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.

# Public URL of the site (used for canonical links, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://jera.ch

# --- Contact form (SMTP) -----------------------------------------------------
# Without these, the form shows a clear "not set up yet" message instead of sending.
SMTP_HOST=mail.example.ch
SMTP_PORT=587
# "true" for port 465 (implicit TLS); "false" for 587 (STARTTLS). Defaults by port.
SMTP_SECURE=false
SMTP_USER=website@jera.ch
SMTP_PASS=
# Mailbox that receives contact requests.
CONTACT_TO=info@jera.ch
# Sender address; must be allowed by your SMTP provider. Defaults to SMTP_USER.
CONTACT_FROM=website@jera.ch
